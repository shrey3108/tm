# App
PROJECT_NAME="AIRA Talent" # Do not forgat to change in index.html
ENVIRONMENT="development"
DEBUG=True
APP_BASE_URL="http://localhost:8000"

# Auth
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Optional explicit database URL
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost/app

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Resume uploads
RESUME_MAX_SIZE_MB=5
RESUME_UPLOAD_DIR=uploads/resumes
TASK_UPLOAD_DIR=uploads/tasks

# Embeddings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_VECTOR_DIM=384
EMBEDDING_TRUNCATE_DIM=384
EMBEDDING_USE_INSTRUCTIONS=False


# Ollama
OLLAMA_URL="https://ollama.com/"
OLLAMA_MODEL="gpt-oss:120b-cloud"
ENHANCE_MODEL="gemma4:31b-cloud" # Optional: Use a separate model for prompt enhancement
OLLAMA_API_KEY=GET_YOUR_KEY_FROM_OLLAMA_CLOUD  # Get your Ollama cloud key from https://ollama.com/settings/keys

# Redis
REDIS_URL=redis://redis:6379/0

# Arize Phoenix - Observability
ENABLE_OBSERVABILITY=True
PHOENIX_PROJECT_NAME=hirego-ai
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317


# LangExtract Retry settings
LANGEXTRACT_RETRY_ATTEMPTS=3
LANGEXTRACT_RETRY_DELAY=60



# Frontend
VITE_API_URL=/api/v1
VITE_ADMIN_API_ENDPOINT="/admin"
VITE_RESUME_MAX_SIZE_MB=5

# GitHub Evaluator Microservice
GITHUB_EVALUATOR_URL="http://127.0.0.1:8000/evaluator"

# Evaluator Specific Database Configurations to prevent conflicts with main db
EVALUATOR_POSTGRES_SERVER=localhost
EVALUATOR_POSTGRES_PORT=5432
EVALUATOR_POSTGRES_USER=postgres
EVALUATOR_POSTGRES_PASSWORD=root
EVALUATOR_POSTGRES_DB=github_evalutor

# Evaluator Specific LLM Configurations
OPENAI_API_KEY="your-openai-api-key"
LITELLM_CONFIG_PATH="config/litellm.yaml"
LITELLM_BASE_URL="https://ollama.com/v1"
LLM_MODEL="gemma4:31b-cloud"
LLM_MODEL_LOGIC="gpt-oss:120b-cloud"

# Default Recruiter/Candidate emails (takes precedence over dynamic profiles if set)
DEFAULT_RECRUITER_EMAIL="shreyshukla512@gmail.com"
DEFAULT_CANDIDATE_EMAIL="12202040601060@adit.ac.in"

# Evaluation Prompt configurations
EVALUATION_PROMPT_VERSION="v1"

# SMTP Configurations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_TARGET_EMAIL_OVERRIDE="your-target-email"  # Optional: For testing, overrides candidate email and routes all emails to this address
