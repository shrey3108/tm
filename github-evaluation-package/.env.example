# Application configurations
PROJECT_NAME="GitHub Code Evaluator"
ENVIRONMENT="development"
DEBUG=True
REPO_ACCESS_GRACE_PERIOD_HOURS=10

# JWT Configurations (RS256 PEM format)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5435
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="github_evaluator"

# LLM Configurations
OPENAI_API_KEY="your-ollama-cloud-api-key-here"
LITELLM_API_KEY=""
LITELLM_CONFIG_PATH="config/litellm.yaml"
LITELLM_BASE_URL="https://ollama.com/v1"
LLM_MODEL="gemma4:31b-cloud"
LLM_MODEL_LOGIC="gpt-oss:120b-cloud"

# SMTP Configurations
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.com"
HR_EMAIL="hr@example.com"

# Prompt Configurations
EVALUATION_PROMPT_VERSION="v1"

# Redis & Celery configurations
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=86400
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_WORKER_CONCURRENCY=4
MAX_QUEUE_DEPTH=10
EVALUATION_LLM_TIMEOUT=300.0

# OpenTelemetry & Observability (Optional)
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006/v1/traces"
